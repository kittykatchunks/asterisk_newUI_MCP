-		info->description = "Invalid descriptor denies success for observed and error envelopes.";
+		info->summary = "Invalid, blocked, and partial output failures cannot report transport success";
+		info->description = "Observed and error envelopes fail on invalid/full pipes; partial output retains only its exact prefix.";
 		return AST_TEST_NOT_RUN;
 	case TEST_EXECUTE:
 		break;
 	}
 	for (i = 0; i < ARRAY_LEN(errors); ++i) {
 		sample.error = errors[i];
 		if (policy_snapshot_respond(-1, &sample, "\"cp-aaaaaaaaaaaaaaaaaaaaaaaa\"") != CLI_FAILURE) {
 			ast_test_status_update(test, "Invalid output descriptor reported transport success\n");
 			return AST_TEST_FAIL;
 		}
+		if (policy_test_partial_response(test, &sample)) {
+			return AST_TEST_FAIL;
+		}
 	}
+	if (policy_test_output_backpressure(test)) {
+		return AST_TEST_FAIL;
+	}
 	return AST_TEST_PASS;
 }
