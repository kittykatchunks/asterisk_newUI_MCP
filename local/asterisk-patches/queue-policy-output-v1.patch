+static int policy_test_output_backpressure(struct ast_test *test)
+{
+	const char *errors[] = { NULL, "busy" };
+	struct policy_snapshot sample = { 0 };
+	int descriptors[2] = { -1, -1 };
+	char buffer[4096] = { 0 };
+	size_t filled = 0, drained = 0;
+	ssize_t bytes;
+	unsigned int i;
+	int failed = 1;
+
+	if (ast_pipe_nonblock(descriptors)) {
+		ast_test_status_update(test, "Could not create backpressure pipe\n");
+		goto done;
+	}
+	for (;;) {
+		bytes = write(descriptors[1], buffer, sizeof(buffer));
+		if (bytes > 0) {
+			filled += bytes;
+			continue;
+		}
+		if (bytes < 0 && errno == EINTR) {
+			continue;
+		}
+		if (bytes < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+			break;
+		}
+		ast_test_status_update(test, "Could not fill nonblocking response pipe\n");
+		goto done;
+	}
+	if (!filled) {
+		ast_test_status_update(test, "Backpressure pipe accepted no bytes\n");
+		goto done;
+	}
+	for (i = 0; i < ARRAY_LEN(errors); ++i) {
+		sample.error = errors[i];
+		if (policy_snapshot_respond(descriptors[1], &sample,
+			"\"cp-aaaaaaaaaaaaaaaaaaaaaaaa\"") != CLI_FAILURE) {
+			ast_test_status_update(test, "Full response pipe reported transport success\n");
+			goto done;
+		}
+	}
+	{
+		int writer = descriptors[1];
+
+		descriptors[1] = -1;
+		if (close(writer)) {
+			ast_test_status_update(test, "Could not close backpressure writer\n");
+			goto done;
+		}
+	}
+	for (;;) {
+		bytes = read(descriptors[0], buffer, sizeof(buffer));
+		if (bytes > 0) {
+			drained += bytes;
+			continue;
+		}
+		if (bytes < 0 && errno == EINTR) {
+			continue;
+		}
+		break;
+	}
+	if (bytes < 0 || drained != filled) {
+		ast_test_status_update(test, "Backpressure pipe contents changed during failure (%zu/%zu)\n",
+			drained, filled);
+		goto done;
+	}
+	{
+		int reader = descriptors[0];
+
+		descriptors[0] = -1;
+		if (close(reader)) {
+			ast_test_status_update(test, "Could not close backpressure reader\n");
+			goto done;
+		}
+	}
+	failed = 0;
+done:
+	if (descriptors[1] >= 0) {
+		if (close(descriptors[1])) {
+			ast_test_status_update(test, "Could not close backpressure writer during cleanup\n");
+			failed = 1;
+		}
+	}
+	if (descriptors[0] >= 0) {
+		if (close(descriptors[0])) {
+			ast_test_status_update(test, "Could not close backpressure reader during cleanup\n");
+			failed = 1;
+		}
+	}
+	return failed;
+}
+
+static int policy_test_partial_response(struct ast_test *test, struct policy_snapshot *sample)
+{
+	const char expected[] = "{\"schema";
+	char output[64];
+	int descriptors[2] = { -1, -1 };
+	size_t used = 0;
+	ssize_t bytes = 0;
+	char *response;
+	int overflow = 0, failed = 1;
+
+	if (ast_pipe_nonblock(descriptors)) {
+		ast_test_status_update(test, "Could not create partial response pipe\n");
+		goto done;
+	}
+	sample->test_write_prefix = sizeof(expected) - 1;
+	response = policy_snapshot_respond(descriptors[1], sample,
+		"\"cp-aaaaaaaaaaaaaaaaaaaaaaaa\"");
+	sample->test_write_prefix = 0;
+	{
+		int writer = descriptors[1];
+
+		descriptors[1] = -1;
+		if (close(writer)) {
+			ast_test_status_update(test, "Could not close partial response writer\n");
+			goto done;
+		}
+	}
+	for (;;) {
+		bytes = read(descriptors[0], output + used, sizeof(output) - used);
+		if (bytes > 0) {
+			if ((size_t) bytes > sizeof(output) - used) {
+				overflow = 1;
+				break;
+			}
+			used += bytes;
+			continue;
+		}
+		if (bytes < 0 && errno == EINTR) {
+			continue;
+		}
+		break;
+	}
+	if (response != CLI_FAILURE || bytes < 0 || overflow || used != sizeof(expected) - 1
+		|| memcmp(output, expected, sizeof(expected) - 1)) {
+		ast_test_status_update(test, "Partial response did not preserve exactly the injected prefix\n");
+		goto done;
+	}
+	{
+		int reader = descriptors[0];
+
+		descriptors[0] = -1;
+		if (close(reader)) {
+			ast_test_status_update(test, "Could not close partial response reader\n");
+			goto done;
+		}
+	}
+	failed = 0;
+done:
+	sample->test_write_prefix = 0;
+	if (descriptors[1] >= 0) {
+		if (close(descriptors[1])) {
+			ast_test_status_update(test, "Could not close partial response writer during cleanup\n");
+			failed = 1;
+		}
+	}
+	if (descriptors[0] >= 0) {
+		if (close(descriptors[0])) {
+			ast_test_status_update(test, "Could not close partial response reader during cleanup\n");
+			failed = 1;
+		}
+	}
+	return failed;
+}
+
 AST_TEST_DEFINE(policy_snapshot_output_failure)
 {
 	const char *errors[] = { NULL, "busy" };
 	struct policy_snapshot sample = { 0 };
@@ -12554,17 +12738,23 @@
 		info->name = "policy_snapshot_output_failure";
 		info->category = "/apps/app_queue/policy_snapshot/";
