diff --git a/main/asterisk.c b/main/asterisk.c
--- a/main/asterisk.c
+++ b/main/asterisk.c
@@ -1718,8 +1718,45 @@ static void really_quit(int num, shutdown_nice_t niceness, int restart)
 	int active_channels;
+#ifdef TEST_FRAMEWORK
+	int module_shutdown_result = 0;
+#endif
 	struct ast_json *json_object = NULL;
 	int run_cleanups = niceness >= SHUTDOWN_NICE;
 
+#ifdef TEST_FRAMEWORK
+	if (run_cleanups) {
+		const char *test_mode = getenv("ASTERISK_CLI_LEASE_TEST_MODE");
+		if (test_mode && !strcmp(test_mode, "before-admission")
+			&& ast_cli_lease_test_supervisor_event(
+				AST_CLI_LEASE_TEST_BEFORE_MODULE_SHUTDOWN, 0, 1)) {
+			_exit(1);
+		}
+		module_shutdown_result = modules_shutdown();
+		if (test_mode && !strcmp(test_mode, "after-admission")) {
+			int shutdown_retry_result;
+			if (ast_cli_lease_test_supervisor_event(
+				AST_CLI_LEASE_TEST_SHUTDOWN_AFTER_MODULES, module_shutdown_result, 1)
+				|| module_shutdown_result != 1) {
+				_exit(1);
+			}
+			shutdown_retry_result = modules_shutdown();
+			if (ast_cli_lease_test_supervisor_event(
+				AST_CLI_LEASE_TEST_SHUTDOWN_RETRY, shutdown_retry_result, 1)
+				|| shutdown_retry_result) {
+				_exit(1);
+			}
+		} else if (test_mode && !strcmp(test_mode, "before-admission")
+			&& ast_cli_lease_test_supervisor_event(
+				AST_CLI_LEASE_TEST_SHUTDOWN_COMPLETE, module_shutdown_result, 1)) {
+			_exit(1);
+		}
+		if (module_shutdown_result) {
+			ast_verb(0, "Some modules could not be unloaded, switching to fast shutdown\n");
+			run_cleanups = 0;
+		}
+	}
+#else
 	if (run_cleanups && modules_shutdown()) {
 		ast_verb(0, "Some modules could not be unloaded, switching to fast shutdown\n");
 		run_cleanups = 0;
 	}
+#endif
