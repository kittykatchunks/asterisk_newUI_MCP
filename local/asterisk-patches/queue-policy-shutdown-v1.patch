+
+static const char *cli_lease_test_supervisor_event_name(enum ast_cli_lease_test_event event)
+{
+	switch (event) {
+	case AST_CLI_LEASE_TEST_ADMITTED: return "dispatch-admitted";
+	case AST_CLI_LEASE_TEST_RELEASED: return "lease-released";
+	case AST_CLI_LEASE_TEST_BEFORE_MODULE_SHUTDOWN: return "before-module-shutdown";
+	case AST_CLI_LEASE_TEST_SHUTDOWN_AFTER_MODULES: return "shutdown-after-modules";
+	case AST_CLI_LEASE_TEST_SHUTDOWN_RETRY: return "shutdown-retry";
+	case AST_CLI_LEASE_TEST_SHUTDOWN_DENIED: return "shutdown-denied";
+	case AST_CLI_LEASE_TEST_SHUTDOWN_COMPLETE: return "shutdown-complete";
+	default: return NULL;
+	}
+}
+
+int ast_cli_lease_test_supervisor_event(enum ast_cli_lease_test_event event, int value, int wait)
+{
+	const char *path = getenv("ASTERISK_CLI_LEASE_TEST_SOCKET");
+	const char *name = cli_lease_test_supervisor_event_name(event);
+	struct sockaddr_un address = { .sun_family = AF_UNIX };
+	struct timeval timeout = { .tv_sec = 10, .tv_usec = 0 };
+	char message[128];
+	char response;
+	int fd = -1;
+	int length;
+	int sent = 0;
+	int result = -1;
+
+	if (ast_strlen_zero(path) || !name || strlen(path) >= sizeof(address.sun_path)) {
+		ast_log(LOG_ERROR, "Invalid protected CLI supervisor socket configuration\n");
+		return -1;
+	}
+	strcpy(address.sun_path, path);
+	length = snprintf(message, sizeof(message), "1 %s %d %d\n", name, value, !!wait);
+	if (length < 0 || length >= sizeof(message)) {
+		ast_log(LOG_ERROR, "Protected CLI supervisor event does not fit protocol buffer\n");
+		return -1;
+	}
+	fd = socket(AF_UNIX, SOCK_STREAM, 0);
+	if (fd < 0) {
+		goto done;
+	}
+	if (setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout))
+		|| setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout))
+		|| connect(fd, (struct sockaddr *)&address, sizeof(address))) {
+		goto done;
+	}
+	while (sent < length) {
+		int written = send(fd, message + sent, length - sent, MSG_NOSIGNAL);
+		if (written < 0 && errno == EINTR) {
+			continue;
+		}
+		if (written <= 0) {
+			goto done;
+		}
+		sent += written;
+	}
+	if (recv(fd, &response, sizeof(response), 0) != sizeof(response) || response != 'C') {
+		goto done;
+	}
+	result = 0;
+done:
+	if (fd >= 0) {
+		close(fd);
+	}
+	if (result) {
+		ast_log(LOG_ERROR, "Protected CLI supervisor event '%s' failed: %s\n",
+			name, strerror(errno));
+	}
+	return result;
+}
 #endif
