+/*! Borrowed visitor: return 0 to continue, 1 to abort; no ownership changes. */
+typedef int (*ao2_bounded_visitor)(void *object, void *context);
+
+/*!
+ * \brief Visit a live mutex hash/list without acquiring references.
+ *
+ * Caller guarantees container lifetime and must not hold its mutex. Visitor
+ * must not block, allocate, mutate/reenter the container, or retain pointers.
+ * Limits v1 ceilings are 64 buckets, 128 physical nodes, 64 live objects.
+ * A complete result alone establishes full traversal. All other results are
+ * incomplete. Result storage is required; no cursor or cleanup escapes.
+ */
