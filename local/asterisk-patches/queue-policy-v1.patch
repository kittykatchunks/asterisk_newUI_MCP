+#ifdef TEST_FRAMEWORK
+static int policy_test_response(struct ast_test *test, struct policy_snapshot *sample,
+	const char *expected)
+{
+	int descriptors[2];
+	char output[8192];
+	size_t used = 0, length = strlen(expected);
+	ssize_t bytes = 0;
+	char *response;
+
+	if (ast_pipe_nonblock(descriptors)) {
+		ast_test_status_update(test, "Could not create nonblocking response capture\n");
+		return 1;
+	}
+	response = policy_snapshot_respond(descriptors[1], sample, "\"cp-aaaaaaaaaaaaaaaaaaaaaaaa\"");
+	close(descriptors[1]);
+	while (used < sizeof(output) && (bytes = read(descriptors[0], output + used,
+		sizeof(output) - used)) > 0) {
+		used += bytes;
+	}
+	close(descriptors[0]);
+	if (response != CLI_SUCCESS || bytes < 0 || used != length || memcmp(output, expected, length)) {
+		ast_test_status_update(test, "Policy response mismatched expected %zu bytes (got %zu)\n",
+			length, used);
+		return 1;
+	}
+	return 0;
+}
