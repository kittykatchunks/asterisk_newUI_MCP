+struct policy_snapshot_row {
+	char name[97];
+	int strategy;
+	int timeout;
+	unsigned int join_mask;
+	unsigned int leave_mask;
+	int members;
+	int callers;
+	int caller_list_empty;
+};
+
+struct policy_snapshot {
+	char namespace[28];
+	struct policy_snapshot_row rows[8];
+	unsigned int count;
+	const char *error;
+};
+
+static int policy_snapshot_visit(void *object, void *context)
+{
+	struct call_queue *q = object;
+	struct policy_snapshot *sample = context;
+	struct policy_snapshot_row row = { 0 };
+	size_t length = strnlen(q->name, sizeof(row.name));
+	int selected, reserved, lock_result;
+	unsigned int i;
+
+	if (length == sizeof(row.name)) {
+		sample->error = "unsupported-state";
+		return 1;
+	}
+	reserved = length > 27 && !strncasecmp(q->name, sample->namespace, 27)
+		&& q->name[27] == '-';
+	selected = reserved || !strcasecmp(q->name, "proof-queue");
+	if (!selected) {
+		return 0;
+	}
+	for (i = 0; i < length; ++i) {
+		char c = q->name[i];
+		if (!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9')
+			|| (i && (c == '-' || c == '_')))) {
+			sample->error = "unsupported-state";
+			return 1;
+		}
+	}
+	if (reserved && (length < 29 || length > 60
+		|| q->name[28] < 'a' || q->name[28] > 'z')) {
+		sample->error = "unsupported-state";
+		return 1;
+	}
+	if (reserved) {
+		for (i = 28; i < length; ++i) {
+			if (q->name[i] == '_') {
+				sample->error = "unsupported-state";
+				return 1;
+			}
+		}
+	}
+	for (i = 0; i < sample->count; ++i) {
+		if (!strcmp(sample->rows[i].name, q->name)) {
+			sample->error = "unsupported-state";
+			return 1;
+		}
+	}
+	if (sample->count == ARRAY_LEN(sample->rows)) {
+		sample->error = "limit";
+		return 1;
+	}
+	if ((ao2_options_get(q) & AO2_ALLOC_OPT_LOCK_MASK) != AO2_ALLOC_OPT_LOCK_MUTEX) {
+		sample->error = "unsupported-state";
+		return 1;
+	}
+	lock_result = ao2_trylock(q);
+	if (lock_result) {
+		sample->error = lock_result == EBUSY ? "busy" : "internal";
+		return 1;
+	}
+	if (q->realtime) {
+		sample->error = "unsupported-state";
+		goto queue_done;
+	}
+	if (q->dead || !q->members
+		|| (ao2_options_get(q->members) & AO2_ALLOC_OPT_LOCK_MASK) != AO2_ALLOC_OPT_LOCK_MUTEX) {
+		sample->error = "unsupported-state";
+		goto queue_done;
+	}
+	lock_result = ao2_trylock(q->members);
+	if (lock_result) {
+		sample->error = lock_result == EBUSY ? "busy" : "internal";
+		goto queue_done;
+	}
+	row.members = ao2_container_count(q->members);
+	if (ao2_unlock(q->members)) {
+		sample->error = "internal";
+		goto queue_done;
+	}
+	row.strategy = q->strategy;
+	row.timeout = q->timeout;
+	row.join_mask = q->joinempty;
+	row.leave_mask = q->leavewhenempty;
+	row.callers = q->count;
+	row.caller_list_empty = !q->head;
+	if (row.strategy < QUEUE_STRATEGY_RINGALL || row.strategy > QUEUE_STRATEGY_RRORDERED
+		|| row.timeout < 0 || row.timeout > 86400
+		|| row.join_mask > 255 || row.leave_mask > 255
+		|| row.members < 0 || row.members > 65535
+		|| row.callers < 0 || row.callers > 65535
+		|| (!row.callers != row.caller_list_empty)) {
+		sample->error = "unsupported-state";
+		goto queue_done;
+	}
+	memcpy(row.name, q->name, length + 1);
+queue_done:
+	if (ao2_unlock(q)) {
+		sample->error = "internal";
+	}
+	if (sample->error) {
+		return 1;
+	}
+	sample->rows[sample->count++] = row;
+	return 0;
+}
+
+static int policy_snapshot_compare(const void *left, const void *right)
+{
+	const struct policy_snapshot_row *a = left, *b = right;
+	return strcmp(a->name, b->name);
+}
+
+static char *policy_snapshot_respond(int fd, struct policy_snapshot *sample,
+	const char *namespace_json)
+{
+	char output[8192];
+	size_t used;
+	unsigned int i;
+	int written;
+
+	if (sample->error) {
+		written = snprintf(output, sizeof(output), "{\"schemaVersion\":1,\"reader\":\"app-queue-policy-v1\","
+			"\"maskMapping\":\"asterisk-22-empty-v1\",\"namespace\":%s,"
+			"\"status\":\"error\",\"code\":\"%s\"}\n", namespace_json, sample->error);
+		goto output_ready;
+	}
+	qsort(sample->rows, sample->count, sizeof(sample->rows[0]), policy_snapshot_compare);
+	written = snprintf(output, sizeof(output),
+		"{\"schemaVersion\":1,\"reader\":\"app-queue-policy-v1\","
+		"\"maskMapping\":\"asterisk-22-empty-v1\",\"status\":\"observed\","
+		"\"namespace\":%s,\"consistency\":\"bounded-per-object-sample\",\"objects\":[",
+		namespace_json);
+	if (written < 0 || (size_t) written >= sizeof(output)) {
+		goto output_error;
+	}
+	used = written;
+	for (i = 0; i < sample->count; ++i) {
+		const struct policy_snapshot_row *row = &sample->rows[i];
+		const char *strategy = NULL;
+		unsigned int index;
+
+		for (index = 0; index < ARRAY_LEN(strategies); ++index) {
+			if (strategies[index].strategy == row->strategy) {
+				strategy = strategies[index].name;
+				break;
+			}
+		}
+		if (!strategy) {
+			goto output_error;
+		}
+		written = snprintf(output + used, sizeof(output) - used,
+			"%s{\"name\":\"%s\",\"origin\":\"static\",\"strategy\":\"%s\","
+			"\"memberTimeoutSeconds\":%d,\"joinEmptyMask\":%u,\"leaveWhenEmptyMask\":%u,"
+			"\"memberCount\":%d,\"callerCount\":%d,\"callerListEmpty\":%s}",
+			i ? "," : "", row->name, strategy, row->timeout, row->join_mask,
+			row->leave_mask, row->members, row->callers, row->caller_list_empty ? "true" : "false");
+		if (written < 0 || (size_t) written >= sizeof(output) - used) {
+			goto output_error;
+		}
+		used += written;
+	}
+	if (sizeof(output) - used < 4) {
+		goto output_error;
+	}
+	memcpy(output + used, "]}\n", 4);
+	written = used + 3;
+	goto output_ready;
+output_error:
+	written = snprintf(output, sizeof(output), "{\"schemaVersion\":1,\"reader\":\"app-queue-policy-v1\","
+		"\"maskMapping\":\"asterisk-22-empty-v1\",\"namespace\":%s,"
+		"\"status\":\"error\",\"code\":\"internal\"}\n", namespace_json);
+output_ready:
+	if (written < 0 || (size_t) written >= sizeof(output)) {
+		ast_log(LOG_ERROR, "Could not format bounded queue policy response\n");
+		return CLI_FAILURE;
+	}
+	return ast_carefulwrite(fd, output, written, 100) < 0 ? CLI_FAILURE : CLI_SUCCESS;
+}
+
+static char *handle_queue_policy_snapshot(struct ast_cli_entry *e, int cmd, struct ast_cli_args *a)
+{
+	const struct ao2_bounded_limits limits = { 1, 64, 128, 64 };
+	struct ao2_bounded_result result;
+	struct policy_snapshot sample = { 0 };
+	const char *namespace_json = "null";
+	char quoted_namespace[30];
+	unsigned int i;
+
+	switch (cmd) {
+	case CLI_INIT:
+		e->command = "queue policy snapshot";
+		e->usage = "Usage: queue policy snapshot cp-<24 lowercase hex digits>\n";
+		return NULL;
+	case CLI_GENERATE:
+		return NULL;
+	}
+	if (a->argc != 4 || strnlen(a->argv[3], 28) != 27
+		|| memcmp(a->argv[3], "cp-", 3)) {
+		sample.error = "invalid-request";
+		goto respond;
+	}
+	for (i = 3; i < 27; ++i) {
+		char c = a->argv[3][i];
+		if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) {
+			sample.error = "invalid-request";
+			goto respond;
+		}
+	}
+	memcpy(sample.namespace, a->argv[3], 28);
+	snprintf(quoted_namespace, sizeof(quoted_namespace), "\"%s\"", sample.namespace);
+	namespace_json = quoted_namespace;
+	if (!queues) {
+		sample.error = "unsupported-state";
+		goto respond;
+	}
+	ao2_container_visit_bounded_v1(queues, &limits, policy_snapshot_visit, &sample, &result);
+	switch (result.status) {
+	case AO2_BOUNDED_COMPLETE:
+		break;
+	case AO2_BOUNDED_BUSY:
+		sample.error = "busy";
+		break;
+	case AO2_BOUNDED_LIMIT:
+		sample.error = "limit";
+		break;
+	case AO2_BOUNDED_UNSUPPORTED:
+		sample.error = "unsupported-state";
+		break;
+	case AO2_BOUNDED_ABORTED:
+		if (!sample.error) {
+			sample.error = "internal";
+		}
+		break;
+	default:
+		sample.error = "internal";
+	}
+respond:
+	return policy_snapshot_respond(a->fd, &sample, namespace_json);
+}
