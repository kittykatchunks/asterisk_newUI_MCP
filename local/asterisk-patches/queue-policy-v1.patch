+static char *handle_queue_policy_snapshot(struct ast_cli_entry *e, int cmd, struct ast_cli_args *a)
+{
+	const struct ao2_bounded_limits limits = { 1, 64, 128, 64 };
+	struct ao2_bounded_result result;
+	struct policy_snapshot sample = { 0 };
+	char output[8192];
+	const char *namespace_json = "null";
+	char quoted_namespace[30];
+	size_t used;
+	unsigned int i;
+	int written;
+
+	switch (cmd) {
+	case CLI_INIT:
+		e->command = "queue policy snapshot";
+		e->usage = "Usage: queue policy snapshot cp-<24 lowercase hex digits>\n";
+		return NULL;
+	case CLI_GENERATE:
+		return NULL;
+	}
+	if (a->argc != 4 || strnlen(a->argv[3], 28) != 27
+		|| memcmp(a->argv[3], "cp-", 3)) {
+		sample.error = "invalid-request";
+		goto respond;
+	}
+	for (i = 3; i < 27; ++i) {
+		char c = a->argv[3][i];
+		if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) {
+			sample.error = "invalid-request";
+			goto respond;
+		}
+	}
+	memcpy(sample.namespace, a->argv[3], 28);
+	snprintf(quoted_namespace, sizeof(quoted_namespace), "\"%s\"", sample.namespace);
+	namespace_json = quoted_namespace;
+	if (!queues) {
+		sample.error = "unsupported-state";
+		goto respond;
+	}
+	ao2_container_visit_bounded_v1(queues, &limits, policy_snapshot_visit, &sample, &result);
+	switch (result.status) {
+	case AO2_BOUNDED_COMPLETE:
+		break;
+	case AO2_BOUNDED_BUSY:
+		sample.error = "busy";
+		break;
+	case AO2_BOUNDED_LIMIT:
+		sample.error = "limit";
+		break;
+	case AO2_BOUNDED_UNSUPPORTED:
+		sample.error = "unsupported-state";
+		break;
+	case AO2_BOUNDED_ABORTED:
+		if (!sample.error) {
+			sample.error = "internal";
+		}
+		break;
+	default:
+		sample.error = "internal";
+	}
+respond:
+	if (sample.error) {
+		return ast_cli(a->fd, "{\"schemaVersion\":1,\"reader\":\"app-queue-policy-v1\","
+			"\"maskMapping\":\"asterisk-22-empty-v1\",\"namespace\":%s,"
+			"\"status\":\"error\",\"code\":\"%s\"}\n", namespace_json, sample.error) < 0
+			? CLI_FAILURE : CLI_SUCCESS;
+	}
+	qsort(sample.rows, sample.count, sizeof(sample.rows[0]), policy_snapshot_compare);
+	written = snprintf(output, sizeof(output),
+		"{\"schemaVersion\":1,\"reader\":\"app-queue-policy-v1\","
+		"\"maskMapping\":\"asterisk-22-empty-v1\",\"status\":\"observed\","
+		"\"namespace\":%s,\"consistency\":\"bounded-per-object-sample\",\"objects\":[",
+		namespace_json);
+	if (written < 0 || (size_t) written >= sizeof(output)) {
+		goto output_error;
+	}
+	used = written;
+	for (i = 0; i < sample.count; ++i) {
+		const struct policy_snapshot_row *row = &sample.rows[i];
+		const char *strategy = NULL;
+		unsigned int index;
+
+		for (index = 0; index < ARRAY_LEN(strategies); ++index) {
+			if (strategies[index].strategy == row->strategy) {
+				strategy = strategies[index].name;
+				break;
+			}
+		}
+		if (!strategy) {
+			goto output_error;
+		}
+		written = snprintf(output + used, sizeof(output) - used,
+			"%s{\"name\":\"%s\",\"origin\":\"static\",\"strategy\":\"%s\","
+			"\"memberTimeoutSeconds\":%d,\"joinEmptyMask\":%u,\"leaveWhenEmptyMask\":%u,"
+			"\"memberCount\":%d,\"callerCount\":%d,\"callerListEmpty\":%s}",
+			i ? "," : "", row->name, strategy, row->timeout, row->join_mask,
+			row->leave_mask, row->members, row->callers, row->caller_list_empty ? "true" : "false");
+		if (written < 0 || (size_t) written >= sizeof(output) - used) {
+			goto output_error;
+		}
+		used += written;
+	}
+	if (sizeof(output) - used < 4) {
+		goto output_error;
+	}
+	memcpy(output + used, "]}\n", 4);
+	return ast_cli(a->fd, "%s", output) < 0 ? CLI_FAILURE : CLI_SUCCESS;
+output_error:
+	return ast_cli(a->fd, "{\"schemaVersion\":1,\"reader\":\"app-queue-policy-v1\","
+		"\"maskMapping\":\"asterisk-22-empty-v1\",\"namespace\":%s,"
+		"\"status\":\"error\",\"code\":\"internal\"}\n", namespace_json) < 0
+		? CLI_FAILURE : CLI_SUCCESS;
+}
