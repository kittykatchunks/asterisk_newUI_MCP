+AST_TEST_DEFINE(protected_registration)
+{
+	struct ast_cli_entry entry = AST_CLI_DEFINE(protected_test_handler,
+		"Native null-owner fixture", .protected_execution = 1);
+
+	switch (cmd) {
+	case TEST_INIT:
+		info->name = "protected_registration";
+		info->category = "/main/loader/protected_cli/";
+		info->summary = "Protected registration requires an owning module before initialization";
+		info->description = "Null-owner admission fails without initializing or linking an entry.";
+		return AST_TEST_NOT_RUN;
+	case TEST_EXECUTE:
+		break;
+	}
+	if (__ast_cli_register(&entry, NULL) != -1) {
+		ast_test_status_update(test, "Null-owner protected registration was not rejected\n");
+		ast_cli_unregister(&entry);
+		return AST_TEST_FAIL;
+	}
+	if (entry.module || entry.command || entry.usage || entry._full_cmd || entry.inuse
+		|| ast_module_cli_try_acquire(NULL) != -1) {
+		ast_test_status_update(test, "Rejected admission altered metadata or null lease was admitted\n");
+		return AST_TEST_FAIL;
+	}
+	return AST_TEST_PASS;
+}
