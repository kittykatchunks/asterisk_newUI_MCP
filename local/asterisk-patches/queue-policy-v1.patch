+		!= AO2_BOUNDED_INTERNAL || result.objects != 1) {
+		goto done;
+	}
+	{
+		void *object = ao2_alloc(sizeof(int), NULL);
+		int linked;
+
+		if (!object) {
+			goto done;
+		}
+		linked = ao2_link(container, object);
