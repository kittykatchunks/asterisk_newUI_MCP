+AST_TEST_DEFINE(policy_snapshot_contention)
+{
+	struct call_queue *q = NULL, *prefix = NULL;
+	enum ast_test_result_state state = AST_TEST_FAIL;
+	int member_lock, with_prefix, selected;
+
+	switch (cmd) {
+	case TEST_INIT:
+		info->name = "policy_snapshot_contention";
+		info->category = "/apps/app_queue/policy_snapshot/";
+		info->summary = "Queue/member contention aborts without appending and releases acquired locks";
+		info->description = "Cross-thread holders/probes; selected/foreign, zero/one prior row and recovery.";
+		return AST_TEST_NOT_RUN;
+	case TEST_EXECUTE:
+		break;
+	}
+	q = policy_test_queue();
+	prefix = policy_test_queue();
+	if (!q || !prefix) {
+		ast_test_status_update(test, "Could not allocate private queue contention fixtures\n");
+		goto done;
+	}
+	ast_string_field_set(prefix, name, "proof-queue");
