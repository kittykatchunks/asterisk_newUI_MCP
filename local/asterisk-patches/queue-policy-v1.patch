+	switch (cmd) {
+	case CLI_INIT:
+		e->command = "test bounded-policy protected-reader";
+		e->usage = "Native test fixture only\n";
+		return NULL;
+	case CLI_GENERATE:
+		return NULL;
+	}
+	fixture = active_dispatch;
+	if (!fixture) {
+		return CLI_FAILURE;
+	}
+	ast_mutex_lock(&fixture->lock);
+	fixture->entered = 1;
+	ast_cond_signal(&fixture->condition);
+	while (!fixture->release) {
+		ast_cond_wait(&fixture->condition, &fixture->lock);
+	}
+	ast_mutex_unlock(&fixture->lock);
+	return CLI_SUCCESS;
+}
