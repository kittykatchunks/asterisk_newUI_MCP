+static void *dispatch_worker(void *data)
+{
+	struct dispatch_fixture *fixture = data;
+
+	if (fixture->generate) {
+		fixture->completion = ast_cli_generator("test bounded-policy protected-reader x", "x", 0);
+	} else {
+		fixture->dispatch_result = ast_cli_command(fixture->fd, "test bounded-policy protected-reader");
+	}
+	ast_mutex_lock(&fixture->lock);
+	fixture->finished = 1;
+	ast_cond_signal(&fixture->condition);
+	ast_mutex_unlock(&fixture->lock);
+	return NULL;
