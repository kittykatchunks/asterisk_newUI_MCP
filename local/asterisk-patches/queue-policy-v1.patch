+		goto done;
+	}
+	result->status = AO2_BOUNDED_LIMIT;
+	if ((unsigned int) self->n_buckets > limits->max_buckets
+		|| (unsigned int) expected > limits->max_objects) {
+		goto done;
+	}
+	for (bucket = 0; bucket < self->n_buckets; ++bucket) {
+		struct hash_bucket_node *node;
+
+		++result->buckets;
+		node = AST_DLLIST_FIRST(&self->buckets[bucket].list);
+		while (node) {
+			int response;
+
+			if (result->nodes == limits->max_nodes) {
+				goto done;
+			}
+			++result->nodes;
+			if (node->common.obj) {
+				if (result->objects == limits->max_objects) {
+					goto done;
+				}
+				++result->objects;
+				response = visitor(node->common.obj, context);
+				if (response) {
+					result->status = response == 1 ? AO2_BOUNDED_ABORTED : AO2_BOUNDED_INTERNAL;
+					goto done;
+				}
+			}
+			node = AST_DLLIST_NEXT(node, links);
+		}
+	}
+	result->status = result->objects == (unsigned int) expected
+		? AO2_BOUNDED_COMPLETE : AO2_BOUNDED_INTERNAL;
+done:
+	if (ao2_unlock(container)) {
+		result->status = AO2_BOUNDED_INTERNAL;
+	}
+	return result->status;
+}
