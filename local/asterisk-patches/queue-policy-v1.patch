+struct dispatch_fixture {
+	ast_mutex_t lock;
+	ast_cond_t condition;
+	int entered;
+	int release;
+	int fd;
+	int dispatch_result;
+	int finished;
+	int generate;
+	int empty_completion;
+	int handler_command;
