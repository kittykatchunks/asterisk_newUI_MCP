+static char *protected_test_handler(struct ast_cli_entry *e, int cmd, struct ast_cli_args *args)
+{
+	struct dispatch_fixture *fixture;
+
+	switch (cmd) {
+	case CLI_INIT:
+		e->command = "test bounded-policy protected-reader";
+		e->usage = "Native test fixture only\n";
+		return NULL;
+	case CLI_GENERATE:
+		break;
+	}
+	fixture = active_dispatch;
+	if (!fixture) {
+		return cmd == CLI_GENERATE ? NULL : CLI_FAILURE;
+	}
+	ast_mutex_lock(&fixture->lock);
+	fixture->handler_command = cmd;
+	fixture->entered = 1;
+	ast_cond_signal(&fixture->condition);
+	while (!fixture->release) {
+		ast_cond_wait(&fixture->condition, &fixture->lock);
+	}
+	ast_mutex_unlock(&fixture->lock);
+	if (cmd == CLI_GENERATE) {
+		return fixture->empty_completion ? NULL : ast_strdup("xyz");
+	}
+	return fixture->handler_result;
+}
