+		info->summary = "Bounded traversal argument, object and abort boundaries";
+		info->description = "Exercise the actual new owner API, without runtime queue changes.";
+		return AST_TEST_NOT_RUN;
+	case TEST_EXECUTE:
+		break;
+	}
+	container = ao2_container_alloc_list(AO2_ALLOC_OPT_LOCK_MUTEX, 0, NULL, NULL);
+	if (!container) {
+		goto done;
+	}
+	if (ao2_container_visit_bounded_v1(container, &limits, count_visit, &count, &result)
+		!= AO2_BOUNDED_COMPLETE || result.buckets != 1 || result.nodes || count) {
+		goto done;
+	}
+	limits.max_nodes = 0;
+	if (ao2_container_visit_bounded_v1(container, &limits, count_visit, &count, &result)
+		!= AO2_BOUNDED_INVALID || result.buckets || result.nodes || count) {
+		goto done;
+	}
+	limits.max_nodes = 128;
+	for (i = 0; i < 64; ++i) {
+		void *object = ao2_alloc(sizeof(int), NULL);
+		int linked;
+
+		if (!object) {
+			goto done;
+		}
+		linked = ao2_link(container, object);
+		ao2_ref(object, -1);
+		if (!linked) {
+			goto done;
+		}
+	}
+	if (ao2_container_visit_bounded_v1(container, &limits, count_visit, &count, &result)
+		!= AO2_BOUNDED_COMPLETE || result.objects != 64 || result.nodes != 64 || count != 64) {
+		goto done;
+	}
+	count = 0;
+	if (ao2_container_visit_bounded_v1(container, &limits, abort_visit, &count, &result)
+		!= AO2_BOUNDED_ABORTED || count != 1 || result.objects != 1) {
+		goto done;
+	}
+	if (ao2_container_visit_bounded_v1(container, &limits, invalid_visit, NULL, &result)
+		!= AO2_BOUNDED_INTERNAL || result.objects != 1) {
+		goto done;
+	}
+	{
+		void *object = ao2_alloc(sizeof(int), NULL);
+		int linked;
+
+		if (!object) {
+			goto done;
+		}
+		linked = ao2_link(container, object);
+		ao2_ref(object, -1);
+		if (!linked) {
+			goto done;
+		}
+	}
+	count = 0;
+	if (ao2_container_visit_bounded_v1(container, &limits, count_visit, &count, &result)
+		!= AO2_BOUNDED_LIMIT || result.nodes || count) {
+		goto done;
+	}
+	state = AST_TEST_PASS;
+done:
+	if (state != AST_TEST_PASS) {
+		ast_test_status_update(test, "Bounded traversal invariant failed\n");
