+int ast_module_cli_try_acquire(struct ast_module *mod)
+{
+	int res = -1;
+
+	if (!mod || AST_DLLIST_TRYLOCK(&module_list)) {
+		return -1;
+	}
+	if (mod->flags.running && !mod->flags.declined && !mod->cli_closing
+		&& !ast_shutting_down()
+		&& ast_atomic_fetchadd_int(&mod->cli_readers, 0) < INT_MAX) {
+		ast_atomic_fetchadd_int(&mod->cli_readers, 1);
+		res = 0;
+	}
+	AST_DLLIST_UNLOCK(&module_list);
+	return res;
+}
+
+void ast_module_cli_release(struct ast_module *mod)
+{
+	/* The final decrement must be the last access: unload may now free mod. */
+	ast_atomic_fetchadd_int(&mod->cli_readers, -1);
+}
