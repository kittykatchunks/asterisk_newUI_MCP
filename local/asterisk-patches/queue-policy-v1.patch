+static struct call_queue *policy_test_queue(void)
+{
+	struct call_queue *q = ao2_alloc(sizeof(*q), NULL);
+
+	if (!q) {
+		return NULL;
+	}
+	if (ast_string_field_init(q, 128)) {
+		ao2_ref(q, -1);
+		return NULL;
+	}
+	q->members = ao2_container_alloc_list(AO2_ALLOC_OPT_LOCK_MUTEX, 0, NULL, NULL);
+	if (!q->members) {
+		ast_string_field_free_memory(q);
+		ao2_ref(q, -1);
+		return NULL;
+	}
+	q->timeout = 2;
+	return q;
+}
+
+static void policy_test_queue_free(struct call_queue *q)
+{
+	if (q) {
+		ao2_cleanup(q->members);
+		ast_string_field_free_memory(q);
+		ao2_ref(q, -1);
+	}
+}
