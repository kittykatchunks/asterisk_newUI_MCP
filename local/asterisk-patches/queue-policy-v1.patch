+		container = ao2_container_alloc_list(unsupported_locks[i], 0, NULL, NULL);
+		if (!container) {
+			goto done;
+		}
+		if (ao2_container_visit_bounded_v1(container, &limits, count_visit, &count, &result)
+			!= AO2_BOUNDED_UNSUPPORTED || result.buckets || result.nodes || result.objects || count) {
+			goto done;
+		}
+		ao2_cleanup(container);
+		container = NULL;
+	}
+	container = ao2_container_alloc_rbtree(AO2_ALLOC_OPT_LOCK_MUTEX, 0, bounded_sort, NULL);
+	if (!container || ao2_container_visit_bounded_v1(container, &limits, count_visit, &count, &result)
+		!= AO2_BOUNDED_UNSUPPORTED || result.buckets || result.nodes || result.objects || count) {
+		goto done;
+	}
+	state = AST_TEST_PASS;
+done:
+	ao2_cleanup(container);
+	if (state != AST_TEST_PASS) {
+		ast_test_status_update(test, "Bounded API matrix invariant failed\n");
+	}
+	return state;
+}
+
+struct bounded_lock_fixture {
+	ast_mutex_t lock;
+	ast_cond_t condition;
+	struct ao2_container *container;
+	int entered;
+	int release;
+	int lock_result;
+	int unlock_result;
+};
+
+static void *bounded_lock_worker(void *data)
+{
+	struct bounded_lock_fixture *fixture = data;
+
+	fixture->lock_result = ao2_lock(fixture->container);
+	ast_mutex_lock(&fixture->lock);
+	fixture->entered = 1;
+	ast_cond_signal(&fixture->condition);
+	while (!fixture->release) {
+		ast_cond_wait(&fixture->condition, &fixture->lock);
+	}
+	ast_mutex_unlock(&fixture->lock);
+	if (!fixture->lock_result) {
+		fixture->unlock_result = ao2_unlock(fixture->container);
+	}
+	return NULL;
+}
+
+AST_TEST_DEFINE(bounded_contention)
+{
+	struct bounded_lock_fixture fixture = { 0 };
+	const struct ao2_bounded_limits limits = { 1, 64, 128, 64 };
+	struct ao2_bounded_result result;
+	pthread_t worker;
+	unsigned int count = 0;
+	int started = 0, failed = 1;
+
+	switch (cmd) {
+	case TEST_INIT:
+		info->name = "bounded_contention";
+		info->category = "/main/astobj2/bounded_queue_policy/";
+		info->summary = "Cross-thread container lock denies traversal without any visits";
+		info->description = "Condition barriers hold the actual AO2 mutex; no timing sleeps.";
+		return AST_TEST_NOT_RUN;
+	case TEST_EXECUTE:
+		break;
+	}
+	ast_mutex_init(&fixture.lock);
+	ast_cond_init(&fixture.condition, NULL);
+	fixture.container = ao2_container_alloc_list(AO2_ALLOC_OPT_LOCK_MUTEX, 0, NULL, NULL);
+	if (!fixture.container || ast_pthread_create(&worker, NULL, bounded_lock_worker, &fixture)) {
+		goto done;
+	}
+	started = 1;
+	ast_mutex_lock(&fixture.lock);
+	while (!fixture.entered) {
+		ast_cond_wait(&fixture.condition, &fixture.lock);
+	}
+	ast_mutex_unlock(&fixture.lock);
+	if (fixture.lock_result
+		|| ao2_container_visit_bounded_v1(fixture.container, &limits, count_visit, &count, &result)
+		!= AO2_BOUNDED_BUSY || result.status != AO2_BOUNDED_BUSY
+		|| result.buckets || result.nodes || result.objects || count) {
+		goto done;
+	}
+	failed = 0;
+done:
+	if (started) {
+		ast_mutex_lock(&fixture.lock);
+		fixture.release = 1;
+		ast_cond_signal(&fixture.condition);
+		ast_mutex_unlock(&fixture.lock);
+		pthread_join(worker, NULL);
+		if (fixture.unlock_result) {
+			failed = 1;
+		}
+		if (!failed
+			&& (ao2_container_visit_bounded_v1(fixture.container, &limits, count_visit, &count, &result)
+			!= AO2_BOUNDED_COMPLETE || result.buckets != 1
+			|| result.nodes || result.objects || count)) {
+			failed = 1;
+		}
+	}
+	ao2_cleanup(fixture.container);
+	ast_cond_destroy(&fixture.condition);
+	ast_mutex_destroy(&fixture.lock);
+	if (failed) {
+		ast_test_status_update(test, "Cross-thread busy/release invariant failed\n");
+	}
+	return failed ? AST_TEST_FAIL : AST_TEST_PASS;
+}
+
+struct bounded_owned_object {
+	unsigned int *destroyed;
+};
+
+struct bounded_owned_visit {
+	unsigned int seen;
+	unsigned int abort_at;
+	int bad_reference;
+};
+
+static void bounded_owned_destroy(void *object)
+{
+	struct bounded_owned_object *owned = object;
+	++*owned->destroyed;
+}
+
+static int bounded_owned_visit(void *object, void *context)
+{
+	struct bounded_owned_visit *visit = context;
+
+	if (ao2_ref(object, 0) != 1) {
+		visit->bad_reference = 1;
+		return 1;
+	}
+	++visit->seen;
+	return visit->abort_at && visit->seen == visit->abort_at;
+}
+
+AST_TEST_DEFINE(bounded_ownership)
+{
+	const unsigned int abort_positions[] = { 1, 32, 64 };
+	struct ao2_bounded_limits limits = { 1, 64, 128, 64 };
+	struct ao2_bounded_result result;
+	struct ao2_container *container = NULL;
+	struct bounded_owned_visit visit = { 0 };
+	unsigned int destroyed = 0, linked = 0, i;
+	enum ast_test_result_state state = AST_TEST_FAIL;
+
+	switch (cmd) {
+	case TEST_INIT:
+		info->name = "bounded_ownership";
+		info->category = "/main/astobj2/bounded_queue_policy/";
+		info->summary = "Borrowed refs, exact node limit, and first/middle/final abort";
+		info->description = "Container remains sole object owner; cleanup/destructors occur only afterward.";
+		return AST_TEST_NOT_RUN;
+	case TEST_EXECUTE:
+		break;
+	}
+	container = ao2_container_alloc_list(AO2_ALLOC_OPT_LOCK_MUTEX, 0, NULL, NULL);
+	if (!container) {
+		goto done;
+	}
+	for (i = 0; i < 64; ++i) {
+		struct bounded_owned_object *object = ao2_alloc(sizeof(*object), bounded_owned_destroy);
+		int added;
+
+		if (!object) {
+			goto done;
+		}
+		object->destroyed = &destroyed;
+		added = ao2_link(container, object);
+		ao2_ref(object, -1);
+		if (!added) {
+			goto done;
+		}
+		++linked;
+	}
+	for (i = 0; i < ARRAY_LEN(abort_positions); ++i) {
+		visit = (struct bounded_owned_visit) { .abort_at = abort_positions[i] };
+		if (ao2_container_visit_bounded_v1(container, &limits, bounded_owned_visit, &visit, &result)
+			!= AO2_BOUNDED_ABORTED || visit.seen != abort_positions[i] || visit.bad_reference
+			|| result.objects != visit.seen || result.nodes != visit.seen || destroyed
+			|| ao2_container_count(container) != 64 || ao2_ref(container, 0) != 1) {
+			goto done;
+		}
+	}
+	visit = (struct bounded_owned_visit) { 0 };
+	limits.max_nodes = 63;
+	if (ao2_container_visit_bounded_v1(container, &limits, bounded_owned_visit, &visit, &result)
+		!= AO2_BOUNDED_LIMIT || result.nodes != 63 || result.objects != 63
+		|| visit.seen != 63 || visit.bad_reference || destroyed) {
+		goto done;
+	}
+	visit = (struct bounded_owned_visit) { 0 };
+	limits.max_nodes = 64;
+	if (ao2_container_visit_bounded_v1(container, &limits, bounded_owned_visit, &visit, &result)
+		!= AO2_BOUNDED_COMPLETE || result.nodes != 64 || result.objects != 64
+		|| visit.seen != 64 || visit.bad_reference || destroyed
+		|| ao2_container_count(container) != 64 || ao2_ref(container, 0) != 1) {
+		goto done;
+	}
+	state = AST_TEST_PASS;
+done:
+	ao2_cleanup(container);
+	if (destroyed != linked) {
+		state = AST_TEST_FAIL;
+	}
+	if (state != AST_TEST_PASS) {
+		ast_test_status_update(test, "Borrowed ownership/abort/cleanup invariant failed\n");
+	}
+	return state;
+}
+
+static int protected_dispatch_case(struct ast_test *test, int generate,
+	char *handler_result, int empty_completion)
+{
+	struct dispatch_fixture fixture = {
+		.fd = -1, .generate = generate, .handler_result = handler_result,
+		.empty_completion = empty_completion,
+	};
+	pthread_t worker;
+	int registered = 0, started = 0, failed = 1;
+	enum ast_module_unload_mode mode;
+
+	if (ast_mutex_init(&fixture.lock)) {
+		ast_test_status_update(test, "Could not initialize protected CLI fixture mutex\n");
+		return 1;
+	}
+	if (ast_cond_init(&fixture.condition, NULL)) {
+		ast_test_status_update(test, "Could not initialize protected CLI fixture condition\n");
+		ast_mutex_destroy(&fixture.lock);
+		return 1;
+	}
+	fixture.fd = open("/dev/null", O_WRONLY);
+	if (fixture.fd < 0 || active_dispatch) {
+		goto done;
+	}
+	active_dispatch = &fixture;
+	if (ast_cli_register_multiple(protected_entry, ARRAY_LEN(protected_entry))) {
+		goto done;
+	}
+	registered = 1;
+	if (ast_pthread_create(&worker, NULL, dispatch_worker, &fixture)) {
+		goto done;
+	}
+	started = 1;
+	ast_mutex_lock(&fixture.lock);
+	while (!fixture.entered && !fixture.finished) {
+		ast_cond_wait(&fixture.condition, &fixture.lock);
+	}
+	ast_mutex_unlock(&fixture.lock);
+	if (!fixture.entered || fixture.handler_command != (generate ? CLI_GENERATE : CLI_HANDLER)) {
+		goto done;
+	}
+	/* Completion still holds the registry read lock, so do not try a writer here. */
+	if (!generate && !ast_cli_unregister(&protected_entry[0])) {
+		goto done;
+	}
+	for (mode = AST_FORCE_SOFT; mode <= AST_FORCE_HARD; ++mode) {
+		if (!ast_unload_resource(ast_module_name(AST_MODULE_SELF), mode)) {
+			goto done;
+		}
+	}
+	failed = 0;
+done:
+	if (started) {
+		ast_mutex_lock(&fixture.lock);
+		fixture.release = 1;
+		ast_cond_signal(&fixture.condition);
+		ast_mutex_unlock(&fixture.lock);
+		pthread_join(worker, NULL);
+		if (generate) {
+			if (empty_completion ? fixture.completion != NULL
+				: !fixture.completion || strcmp(fixture.completion, "xyz")) {
+				failed = 1;
+			}
+		} else if (!!fixture.dispatch_result != (handler_result != CLI_SUCCESS)) {
+			failed = 1;
+		}
+	}
+	if (registered && protected_entry[0].inuse) {
+		failed = 1;
+	}
+	if (registered && ast_cli_unregister(&protected_entry[0])) {
+		failed = 1;
+	}
+	if (active_dispatch == &fixture) {
+		active_dispatch = NULL;
+	}
+	if (fixture.fd >= 0) {
+		close(fixture.fd);
+	}
+	ast_free(fixture.completion);
+	ast_cond_destroy(&fixture.condition);
+	ast_mutex_destroy(&fixture.lock);
+	if (failed) {
+		ast_test_status_update(test, "Protected CLI invariant failed: generate=%d empty=%d\n",
+			generate, empty_completion);
+	}
+	return failed;
+}
+
+AST_TEST_DEFINE(protected_dispatch)
+{
+	char *outcomes[] = { CLI_SUCCESS, CLI_FAILURE, CLI_SHOWUSAGE };
+	unsigned int i;
+
+	switch (cmd) {
+	case TEST_INIT:
+		info->name = "protected_dispatch";
+		info->category = "/main/loader/protected_cli/";
+		info->summary = "Protected dispatch covers success/failure/usage handler exits";
+		info->description = "Busy unregister and all unload modes refuse each active handler; entry drains afterward.";
+		return AST_TEST_NOT_RUN;
+	case TEST_EXECUTE:
+		break;
+	}
+	for (i = 0; i < ARRAY_LEN(outcomes); ++i) {
+		if (protected_dispatch_case(test, 0, outcomes[i], 0)) {
+			return AST_TEST_FAIL;
+		}
+	}
+	return AST_TEST_PASS;
+}
+
+AST_TEST_DEFINE(protected_completion)
+{
+	int empty;
+
+	switch (cmd) {
+	case TEST_INIT:
+		info->name = "protected_completion";
+		info->category = "/main/loader/protected_cli/";
+		info->summary = "Protected completion holds a real lease through callback return";
+		info->description = "Barrier-held generators veto every unload mode with both nonempty and null completion.";
+		return AST_TEST_NOT_RUN;
+	case TEST_EXECUTE:
+		break;
+	}
+	for (empty = 0; empty <= 1; ++empty) {
+		if (protected_dispatch_case(test, 1, CLI_SUCCESS, empty)) {
+			return AST_TEST_FAIL;
+		}
+	}
+	return AST_TEST_PASS;
+}
