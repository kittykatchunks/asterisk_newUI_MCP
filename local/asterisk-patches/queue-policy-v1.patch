+struct policy_lock_fixture {
+	ast_mutex_t lock;
+	ast_cond_t condition;
+	struct call_queue *queue;
+	void *target;
+	int entered;
+	int release;
+	int lock_result;
+	int unlock_result;
+	int queue_probe;
+	int member_probe;
+	int probe_unlock;
+};
+
+static void *policy_lock_worker(void *data)
+{
+	struct policy_lock_fixture *fixture = data;
+
+	fixture->lock_result = ao2_lock(fixture->target);
+	ast_mutex_lock(&fixture->lock);
+	fixture->entered = 1;
+	ast_cond_signal(&fixture->condition);
+	while (!fixture->release) {
+		ast_cond_wait(&fixture->condition, &fixture->lock);
+	}
+	ast_mutex_unlock(&fixture->lock);
+	if (!fixture->lock_result) {
+		fixture->unlock_result = ao2_unlock(fixture->target);
+	}
+	fixture->queue_probe = ao2_trylock(fixture->queue);
+	if (!fixture->queue_probe) {
+		fixture->probe_unlock |= ao2_unlock(fixture->queue);
+	}
+	fixture->member_probe = ao2_trylock(fixture->queue->members);
+	if (!fixture->member_probe) {
+		fixture->probe_unlock |= ao2_unlock(fixture->queue->members);
+	}
+	return NULL;
+}
+
+static int policy_test_contention(struct ast_test *test, struct call_queue *q,
+	struct call_queue *prefix, int member_lock, int selected)
+{
+	struct policy_lock_fixture fixture = { .queue = q, .target = q };
+	struct policy_snapshot sample = { .namespace = "cp-aaaaaaaaaaaaaaaaaaaaaaaa" };
+	struct policy_snapshot before;
+	pthread_t worker;
+	int started = 0, failed = 1;
+
+	if (member_lock) {
+		fixture.target = q->members;
+	}
+	if (ast_mutex_init(&fixture.lock)) {
+		ast_test_status_update(test, "Could not initialize contention fixture mutex\n");
+		return 1;
+	}
+	if (ast_cond_init(&fixture.condition, NULL)) {
+		ast_test_status_update(test, "Could not initialize contention fixture condition\n");
+		ast_mutex_destroy(&fixture.lock);
+		return 1;
+	}
+	if (prefix && (policy_snapshot_visit(prefix, &sample) || sample.error
+		|| sample.count != 1 || strcmp(sample.rows[0].name, "proof-queue"))) {
+		goto done;
+	}
+	before = sample;
+	ast_string_field_set(q, name, selected
+		? "cp-aaaaaaaaaaaaaaaaaaaaaaaa-target" : "foreign-queue");
+	if (ast_pthread_create(&worker, NULL, policy_lock_worker, &fixture)) {
+		ast_test_status_update(test, "Could not start subordinate lock holder\n");
+		goto done;
+	}
+	started = 1;
+	ast_mutex_lock(&fixture.lock);
+	while (!fixture.entered) {
+		ast_cond_wait(&fixture.condition, &fixture.lock);
+	}
+	ast_mutex_unlock(&fixture.lock);
+	if (fixture.lock_result) {
+		goto done;
+	}
+	{
+		int response = policy_snapshot_visit(q, &sample);
+
+		if (!!response != selected || (selected
+			? !sample.error || strcmp(sample.error, "busy") : sample.error != NULL)
+			|| sample.count != before.count || memcmp(sample.rows, before.rows, sizeof(sample.rows))) {
+			goto done;
+		}
+	}
+	failed = 0;
+done:
+	if (started) {
+		ast_mutex_lock(&fixture.lock);
+		fixture.release = 1;
+		ast_cond_signal(&fixture.condition);
+		ast_mutex_unlock(&fixture.lock);
+		pthread_join(worker, NULL);
+		if (fixture.unlock_result || fixture.queue_probe || fixture.member_probe
+			|| fixture.probe_unlock) {
+			failed = 1;
+		}
+		if (!failed) {
+			sample = before;
+			ast_string_field_set(q, name, "cp-aaaaaaaaaaaaaaaaaaaaaaaa-target");
+			if (policy_snapshot_visit(q, &sample) || sample.error
+				|| sample.count != before.count + 1
+				|| memcmp(sample.rows, before.rows, before.count * sizeof(sample.rows[0]))
+				|| strcmp(sample.rows[before.count].name, q->name)
+				|| sample.rows[before.count].timeout != 2) {
+				failed = 1;
+			}
+		}
+	}
+	ast_cond_destroy(&fixture.condition);
+	ast_mutex_destroy(&fixture.lock);
+	if (failed) {
+		ast_test_status_update(test, "Subordinate contention failed: members=%d prefix=%d selected=%d\n",
+			member_lock, prefix != NULL, selected);
+	}
+	return failed;
+}
