+	struct ao2_container_hash *self;
+	int bucket, expected, lock_result;
+
+	if (!result) {
+		return AO2_BOUNDED_INVALID;
+	}
+	*result = (struct ao2_bounded_result) { .status = AO2_BOUNDED_INVALID };
+	if (!container || !limits || !visitor || limits->version != 1
+		|| !limits->max_buckets || limits->max_buckets > 64
+		|| !limits->max_nodes || limits->max_nodes > 128
+		|| !limits->max_objects || limits->max_objects > 64) {
+		return result->status;
+	}
+	if (container->v_table != &v_table_hash
+		|| (ao2_options_get(container) & AO2_ALLOC_OPT_LOCK_MASK) != AO2_ALLOC_OPT_LOCK_MUTEX) {
+		return result->status = AO2_BOUNDED_UNSUPPORTED;
+	}
+	lock_result = ao2_trylock(container);
+	if (lock_result) {
+		return result->status = lock_result == EBUSY ? AO2_BOUNDED_BUSY : AO2_BOUNDED_INTERNAL;
+	}
+	self = (struct ao2_container_hash *) container;
+	expected = ao2_container_count(container);
+	result->status = AO2_BOUNDED_INTERNAL;
