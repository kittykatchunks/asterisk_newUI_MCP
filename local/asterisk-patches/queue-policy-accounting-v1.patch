+#ifdef TEST_FRAMEWORK
+__thread struct ao2_bounded_work_counters *ao2_bounded_work_active;
+__thread int ao2_bounded_work_suspended;
+
+static void ao2_bounded_work_finish(struct ao2_bounded_result *result, int acquired)
+{
+	struct ao2_bounded_work_counters *work = &result->test_work;
+
+	ao2_bounded_work_active = NULL;
+	ao2_bounded_work_suspended = 0;
+	if (work->lock_attempts != 1 || work->lock_acquisitions != (unsigned int) acquired
+		|| work->unlock_attempts != (unsigned int) acquired
+		|| work->unlock_successes != (unsigned int) acquired
+		|| work->bucket_reads != result->buckets || work->node_reads != result->nodes
+		|| work->ref_calls || work->allocations || work->links || work->unlinks) {
+		result->status = AO2_BOUNDED_INTERNAL;
+	}
+}
+#endif
