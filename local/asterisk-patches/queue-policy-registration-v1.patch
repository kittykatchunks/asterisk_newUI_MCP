diff --git a/tests/test_bounded_queue_policy.c b/tests/test_bounded_queue_policy.c
--- a/tests/test_bounded_queue_policy.c
+++ b/tests/test_bounded_queue_policy.c
@@ -68,6 +68,18 @@ static char *protected_test_handler(struct ast_cli_entry *e, int cmd, struct ast_cli_args *args)
 	return fixture->handler_result;
 }
 
+static char *partial_registration_handler(struct ast_cli_entry *e, int cmd,
+	struct ast_cli_args *args)
+{
+	(void) args;
+	if (cmd == CLI_INIT) {
+		e->command = "test bounded-policy registration-partial";
+		e->usage = "Partial registration cleanup fixture\n";
+		return NULL;
+	}
+	return cmd == CLI_GENERATE ? NULL : CLI_SUCCESS;
+}
+
 static struct ast_cli_entry protected_entry[] = {
 	AST_CLI_DEFINE(protected_test_handler, "Native protected reader fixture", .protected_execution = 1),
 };
@@ -1128,26 +1140,86 @@ AST_TEST_DEFINE(protected_registration)
 {
 	struct ast_cli_entry entry = AST_CLI_DEFINE(protected_test_handler,
 		"Native null-owner fixture", .protected_execution = 1);
+	struct ast_cli_entry blocker[] = {
+		AST_CLI_DEFINE(protected_test_handler, "Registration blocker", .protected_execution = 1),
+	};
+	struct ast_cli_entry entries[] = {
+		AST_CLI_DEFINE(partial_registration_handler, "First registration entry",
+			.protected_execution = 1),
+		AST_CLI_DEFINE(protected_test_handler, "Duplicate registration entry",
+			.protected_execution = 1),
+	};
+	int fd = -1;
+	int blocker_registered = 0;
+	int entries_need_cleanup = 0;
+	int result = AST_TEST_FAIL;
 
 	switch (cmd) {
 	case TEST_INIT:
 		info->name = "protected_registration";
 		info->category = "/main/loader/protected_cli/";
-		info->summary = "Protected registration requires an owning module before initialization";
-		info->description = "Null-owner admission fails without initializing or linking an entry.";
+		info->summary = "Protected registration rejects null owners and cleans partial arrays";
+		info->description = "Null-owner admission has no side effects; failed array registration "
+			"retains its earlier entry until explicit caller cleanup.";
 		return AST_TEST_NOT_RUN;
 	case TEST_EXECUTE:
 		break;
 	}
+	fd = open("/dev/null", O_WRONLY);
+	if (fd < 0) {
+		ast_test_status_update(test, "Could not open /dev/null for registration fixture\n");
+		goto done;
+	}
+	if (ast_cli_register_multiple(blocker, ARRAY_LEN(blocker))) {
+		ast_test_status_update(test, "Could not register partial-array blocker\n");
+		goto done;
+	}
+	blocker_registered = 1;
+	if (!ast_cli_register_multiple(entries, ARRAY_LEN(entries))) {
+		entries_need_cleanup = entries[0].command != NULL;
+		ast_test_status_update(test, "Duplicate array entry did not report registration failure\n");
+		goto done;
+	}
+	entries_need_cleanup = entries[0].command != NULL;
+	if (!entries_need_cleanup || !blocker[0].command || entries[1].command
+		|| ast_cli_command(fd, "test bounded-policy registration-partial")) {
+		ast_test_status_update(test, "Array registration did not preserve the first entry and reject the duplicate\n");
+		goto done;
+	}
+	if (ast_cli_unregister_multiple(entries, ARRAY_LEN(entries))) {
+		entries_need_cleanup = entries[0].command != NULL;
+		ast_test_status_update(test, "Explicit caller cleanup failed after partial registration\n");
+		goto done;
+	}
+	entries_need_cleanup = 0;
+	if (!ast_cli_command(fd, "test bounded-policy registration-partial")) {
+		ast_test_status_update(test, "Explicit caller cleanup left the earlier entry registered\n");
+		goto done;
+	}
 	if (__ast_cli_register(&entry, NULL) != -1) {
 		ast_test_status_update(test, "Null-owner protected registration was not rejected\n");
-		ast_cli_unregister(&entry);
-		return AST_TEST_FAIL;
+		goto done;
 	}
 	if (entry.module || entry.command || entry.usage || entry._full_cmd || entry.inuse
 		|| ast_module_cli_try_acquire(NULL) != -1) {
 		ast_test_status_update(test, "Rejected admission altered metadata or null lease was admitted\n");
-		return AST_TEST_FAIL;
+		goto done;
 	}
-	return AST_TEST_PASS;
+	result = AST_TEST_PASS;
+done:
+	if (entries_need_cleanup && ast_cli_unregister_multiple(entries, ARRAY_LEN(entries))) {
+		ast_test_status_update(test, "Partial array cleanup failed\n");
+		result = AST_TEST_FAIL;
+	}
+	if (blocker_registered && ast_cli_unregister_multiple(blocker, ARRAY_LEN(blocker))) {
+		ast_test_status_update(test, "Could not unregister partial-array blocker\n");
+		result = AST_TEST_FAIL;
+	}
+	if (entry.module || entry.command || entry.usage || entry._full_cmd || entry.inuse) {
+		ast_cli_unregister(&entry);
+	}
+	if (fd >= 0) {
+		close(fd);
+	}
+	return result;
 }
