+static int lifecycle_target_busy_unregister_case(struct ast_test *test)
+{
+	const char target[] = "test_protected_cli_target.so";
+	const char busy_command[] = "test bounded-policy lifecycle-target busy-unregister";
+	const char verify_command[] = "test bounded-policy lifecycle-target success";
+	int fd = -1, loaded = 0, failed = 1;
+
+	if (ast_module_check(target)) {
+		ast_test_status_update(test, "Disposable target already loaded; refusing to adopt it\n");
+		return 1;
+	}
+	fd = open("/dev/null", O_WRONLY);
+	if (fd < 0 || ast_load_resource(target) != AST_MODULE_LOAD_SUCCESS) {
+		goto done;
+	}
+	loaded = 1;
+	if (ast_cli_command(fd, busy_command)) {
+		ast_test_status_update(test, "Active separate-target unregister was not rejected as busy\n");
+		goto done;
+	}
+	if (ast_cli_command(fd, verify_command)) {
+		ast_test_status_update(test, "Busy unregister removed or damaged the active target entry\n");
+		goto done;
+	}
+	failed = 0;
+done:
+	if (loaded && ast_unload_resource(target, AST_FORCE_SOFT)) {
+		ast_test_status_update(test, "Disposable target did not unload after busy unregister\n");
+		failed = 1;
+	}
+	if (fd >= 0) {
+		close(fd);
+	}
+	return failed;
+}
