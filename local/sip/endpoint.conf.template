[proof-client]
type = endpoint
transport = transport-udp
context = sip-proof
disallow = all
allow = ulaw
auth = proof-client-auth
direct_media = no
rtp_symmetric = yes
force_rport = yes
rewrite_contact = yes

[proof-client-auth]
type = auth
auth_type = userpass
username = proof-client
password = @PASSWORD@
