{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["tests/webrtc/client.ts", "src/**/*.ts", "src/**/*.js", "scripts/*.ts", "tests/*.test.ts", "tests/identity/**/*.ts"]
}
